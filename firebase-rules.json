{
  "rules": {
    "gifts": {
      ".read": "auth != null && auth.uid === 'Di2JVtSMK9U611AADd0zMbo7dgx1'",
      "$code": {
        ".read": true,
        ".write": "!data.exists() || (auth != null && auth.uid === 'Di2JVtSMK9U611AADd0zMbo7dgx1')",
        ".validate": "newData.hasChildren(['name','from'])"
      }
    },
    "index": {
      ".read": "auth != null && auth.uid === 'Di2JVtSMK9U611AADd0zMbo7dgx1'",
      "$code": {
        ".write": "!data.exists() || (auth != null && auth.uid === 'Di2JVtSMK9U611AADd0zMbo7dgx1')"
      }
    },
    "replies": {
      ".read": "auth != null && auth.uid === 'Di2JVtSMK9U611AADd0zMbo7dgx1'",
      "$gid": {
        ".read": true,
        "$rid": { ".write": true }
      }
    },
    "settings": {
      ".read": true,
      ".write": "auth != null && auth.uid === 'Di2JVtSMK9U611AADd0zMbo7dgx1'"
    },

    "referrers": {
      ".read": "auth != null && auth.uid === 'Di2JVtSMK9U611AADd0zMbo7dgx1'",
      "$rcode": {
        ".read": true,
        ".write": "(!data.exists() && $rcode.matches(/^[a-z0-9-]{3,40}$/)) || (auth != null && auth.uid === 'Di2JVtSMK9U611AADd0zMbo7dgx1')",
        ".validate": "newData.hasChildren(['name','t']) && newData.child('name').isString() && newData.child('name').val().length <= 30"
      }
    },
    "wallets": {
      ".read": "auth != null && auth.uid === 'Di2JVtSMK9U611AADd0zMbo7dgx1'",
      "$key": {
        ".read": true,
        ".write": "(!data.exists() && $key.matches(/^[a-z0-9]{24}$/)) || (auth != null && auth.uid === 'Di2JVtSMK9U611AADd0zMbo7dgx1')",
        ".validate": "newData.hasChildren(['rcode','name','t'])"
      }
    },
    "referrals": {
      ".read": "auth != null && auth.uid === 'Di2JVtSMK9U611AADd0zMbo7dgx1'",
      "$rcode": {
        ".read": true,
        "$rid": {
          ".write": "(!data.exists() && root.child('referrers').child($rcode).exists()) || (auth != null && auth.uid === 'Di2JVtSMK9U611AADd0zMbo7dgx1')",
          ".validate": "newData.hasChildren(['t','st']) && (newData.child('st').val() === 'pending' || (auth != null && auth.uid === 'Di2JVtSMK9U611AADd0zMbo7dgx1'))"
        }
      }
    },
    "refaudit": {
      ".read": "auth != null && auth.uid === 'Di2JVtSMK9U611AADd0zMbo7dgx1'",
      "$rid": {
        ".write": "!data.exists() || (auth != null && auth.uid === 'Di2JVtSMK9U611AADd0zMbo7dgx1')",
        ".validate": "newData.hasChildren(['rcode','pay','t']) && newData.child('pay').isString() && newData.child('pay').val().matches(/^pay_[A-Za-z0-9]+$/)"
      }
    },
    "refpay": {
      ".read": "auth != null && auth.uid === 'Di2JVtSMK9U611AADd0zMbo7dgx1'",
      "$pay": {
        ".write": "(!data.exists() && $pay.matches(/^pay_[A-Za-z0-9]+$/)) || (auth != null && auth.uid === 'Di2JVtSMK9U611AADd0zMbo7dgx1')"
      }
    },
    "withdrawals": {
      ".read": "auth != null && auth.uid === 'Di2JVtSMK9U611AADd0zMbo7dgx1'",
      "$key": {
        ".read": true,
        "$wid": {
          ".write": "(!data.exists() && root.child('wallets').child($key).exists()) || (auth != null && auth.uid === 'Di2JVtSMK9U611AADd0zMbo7dgx1')",
          ".validate": "newData.hasChildren(['rcode','upi','amount','status','t'])",
          "upi": { ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9._-]{2,256}@[A-Za-z]{2,64}$/)" },
          "amount": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 100000" },
          "status": { ".validate": "newData.isString() && (newData.val() === 'requested' || (auth != null && auth.uid === 'Di2JVtSMK9U611AADd0zMbo7dgx1'))" }
        }
      }
    }
  }
}
