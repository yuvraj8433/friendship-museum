{
  "rules": {
    "gifts": {
      ".read": "auth != null && auth.uid === 'Di2JVtSMK9U611AADd0zMbo7dgx1'",
      "$code": {
        ".read": true,
        ".write": "!data.exists() || (auth != null && auth.uid === 'Di2JVtSMK9U611AADd0zMbo7dgx1')",
        ".validate": "newData.hasChildren(['name','from'])"
      }
    },
    "index": {
      ".read": "auth != null && auth.uid === 'Di2JVtSMK9U611AADd0zMbo7dgx1'",
      "$code": {
        ".write": "!data.exists() || (auth != null && auth.uid === 'Di2JVtSMK9U611AADd0zMbo7dgx1')"
      }
    },
    "replies": {
      ".read": "auth != null && auth.uid === 'Di2JVtSMK9U611AADd0zMbo7dgx1'",
      "$gid": {
        ".read": true,
        "$rid": {
          ".write": true
        }
      }
    },
    "settings": {
      ".read": true,
      ".write": "auth != null && auth.uid === 'Di2JVtSMK9U611AADd0zMbo7dgx1'"
    },
    "referrers": {
      ".read": "auth != null && auth.uid === 'Di2JVtSMK9U611AADd0zMbo7dgx1'",
      "$rcode": {
        ".read": true,
        ".write": "auth != null && auth.uid === 'Di2JVtSMK9U611AADd0zMbo7dgx1'",
        ".validate": "$rcode.matches(/^[a-z0-9-]{3,40}$/) && newData.hasChildren(['name','t']) && newData.child('name').isString() && newData.child('name').val().length <= 30"
      }
    },
    "referrals": {
      ".read": "auth != null && auth.uid === 'Di2JVtSMK9U611AADd0zMbo7dgx1'",
      "$rcode": {
        "$rid": {
          ".write": "(!data.exists() && root.child('referrers').child($rcode).exists()) || (data.exists() && data.child('st').val() === 'pending' && newData.child('st').val() === 'success') || (auth != null && auth.uid === 'Di2JVtSMK9U611AADd0zMbo7dgx1')",
          ".validate": "newData.hasChildren(['t','st']) && (newData.child('st').val() === 'pending' || (data.exists() && data.child('st').val() === 'pending' && newData.child('st').val() === 'success' && root.child('refaudit').child($rid).child('pay').exists() && root.child('refaudit').child($rid).child('rcode').val() === $rcode && root.child('refpay').child(root.child('refaudit').child($rid).child('pay').val()).child('r').val() === $rid && newData.child('t').val() === data.child('t').val() && newData.child('amt').isNumber() && ((root.child('settings').child('refer').child('reward').exists() && newData.child('amt').val() === root.child('settings').child('refer').child('reward').val()) || (!root.child('settings').child('refer').child('reward').exists() && newData.child('amt').val() === 20))) || (auth != null && auth.uid === 'Di2JVtSMK9U611AADd0zMbo7dgx1'))"
        },
        ".read": true
      }
    },
    "refaudit": {
      ".read": "auth != null && auth.uid === 'Di2JVtSMK9U611AADd0zMbo7dgx1'",
      "$rid": {
        ".write": "!data.exists() || (auth != null && auth.uid === 'Di2JVtSMK9U611AADd0zMbo7dgx1')",
        ".validate": "newData.hasChildren(['rcode','pay','t']) && newData.child('pay').isString() && newData.child('pay').val().matches(/^pay_[A-Za-z0-9]+$/)"
      }
    },
    "refpay": {
      ".read": "auth != null && auth.uid === 'Di2JVtSMK9U611AADd0zMbo7dgx1'",
      "$pay": {
        ".write": "(!data.exists() && $pay.matches(/^pay_[A-Za-z0-9]+$/)) || (auth != null && auth.uid === 'Di2JVtSMK9U611AADd0zMbo7dgx1')"
      }
    },
    "refmeta": {
      ".read": "auth != null && auth.uid === 'Di2JVtSMK9U611AADd0zMbo7dgx1'",
      ".write": "auth != null && auth.uid === 'Di2JVtSMK9U611AADd0zMbo7dgx1'"
    },
    "refpaid": {
      ".read": "auth != null && auth.uid === 'Di2JVtSMK9U611AADd0zMbo7dgx1'",
      ".write": "auth != null && auth.uid === 'Di2JVtSMK9U611AADd0zMbo7dgx1'",
      "$id": {
        ".validate": "newData.hasChildren(['rcode','amount','t']) && newData.child('amount').isNumber() && newData.child('amount').val() >= 1 && newData.child('amount').val() <= 100000"
      }
    },
    "refkeys": {
      ".read": "auth != null && auth.uid === 'Di2JVtSMK9U611AADd0zMbo7dgx1'",
      "$pk": {
        ".read": true,
        ".write": "auth != null && auth.uid === 'Di2JVtSMK9U611AADd0zMbo7dgx1'",
        ".validate": "$pk.matches(/^[a-z0-9]{16,40}$/) && newData.isString() && newData.val().matches(/^[a-z0-9-]{3,40}$/)"
      }
    },
    "partner": {
      ".read": "auth != null && auth.uid === 'Di2JVtSMK9U611AADd0zMbo7dgx1'",
      "$pk": {
        ".read": "root.child('refkeys').child($pk).exists()",
        ".write": "root.child('refkeys').child($pk).exists() || (auth != null && auth.uid === 'Di2JVtSMK9U611AADd0zMbo7dgx1')",
        ".validate": "newData.hasChildren() || !newData.exists()",
        "dname": {
          ".validate": "newData.isString() && newData.val().length <= 30"
        },
        "phone": {
          ".validate": "newData.isString() && newData.val().matches(/^[0-9+ ()-]{6,20}$/)"
        },
        "email": {
          ".validate": "newData.isString() && newData.val().length <= 80 && newData.val().matches(/^[^ @]+@[^ @]+\\.[^ @]+$/)"
        },
        "upi": {
          ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9._-]{2,256}@[A-Za-z]{2,64}$/)"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "payreq": {
      ".read": "auth != null && auth.uid === 'Di2JVtSMK9U611AADd0zMbo7dgx1'",
      "$pk": {
        ".read": "root.child('refkeys').child($pk).exists()",
        "$id": {
          ".write": "(!data.exists() && root.child('refkeys').child($pk).exists()) || (auth != null && auth.uid === 'Di2JVtSMK9U611AADd0zMbo7dgx1')",
          ".validate": "newData.hasChildren(['rcode','upi','amount','status','t']) && newData.child('rcode').val() === root.child('refkeys').child($pk).val()",
          "upi": {
            ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9._-]{2,256}@[A-Za-z]{2,64}$/)"
          },
          "amount": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 100000"
          },
          "status": {
            ".validate": "newData.isString() && (newData.val() === 'requested' || (auth != null && auth.uid === 'Di2JVtSMK9U611AADd0zMbo7dgx1'))"
          }
        }
      }
    }
  }
}